# Local values for `npx expo start`. Never committed — EAS injects these per
# build profile instead (see eas.json).
#
# Per ADR-028 the mobile client runs the same Firebase JS SDK as the web client,
# so these are the SAME values as the web app's REACT_APP_FB_* variables. There
# is no separate Firebase app to register for email and password sign-in.

# A phone cannot reach your machine's localhost. Use your LAN address for a
# device build, or http://localhost:8001 when running in a simulator on this Mac.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8001
EXPO_PUBLIC_API_TIMEOUT=10000
EXPO_PUBLIC_SENTRY_DSN=

EXPO_PUBLIC_FB_API_KEY=
EXPO_PUBLIC_FB_AUTH_DOMAIN=
EXPO_PUBLIC_FB_PROJECT_ID=
EXPO_PUBLIC_FB_STORAGE_BUCKET=
EXPO_PUBLIC_FB_MSG_SENDER_ID=
EXPO_PUBLIC_FB_APP_ID=

# Google issues ONE client ID per platform (MOB-017, ADR-028). The wrong one
# fails with `redirect_uri_mismatch` rather than with anything useful, and an
# absent one fails silently — which is how all three came to be read by
# `app.config.js` and declared nowhere (MOB-070). iOS has none yet: no iOS
# build has ever been made, so no iOS OAuth client has been registered.
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=
