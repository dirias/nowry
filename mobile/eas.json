{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_TIMEOUT": "10000"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_TIMEOUT": "10000"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_TIMEOUT": "10000"
      }
    },
    "beta": {
      "extends": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_TIMEOUT": "10000",
        "EXPO_PUBLIC_API_URL": "https://nowry-api-development.up.railway.app"
      }
    },
    "production-apk": {
      "extends": "production",
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_TIMEOUT": "10000"
      }
    },
    "beta-play": {
      "extends": "preview",
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_TIMEOUT": "10000",
        "EXPO_PUBLIC_API_URL": "https://nowry-api-development.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {},
    "beta-play": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
