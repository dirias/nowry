# APP
REACT_APP_API_URL=http://localhost:8000
REACT_APP_API_TIMEOUT=50000
# Deployment target this build represents. Drives Sentry's environment tag and
# its sampling rates. Must be set per environment in Vercel — do NOT rely on
# NODE_ENV, which is 'production' for every optimised build.
# Values: local | development | production
REACT_APP_ENVIRONMENT=local
# SENTRY — leave blank to disable Sentry entirely (init is gated on this)
REACT_APP_SENTRY_DSN=
#FIREBASE
REACT_APP_FB_API_KEY=xxx
REACT_APP_FB_AUTH_DOMAIN=xxx
REACT_APP_FB_PROYECt_ID=xxx
REACT_APP_FB_STORAGE_BUCKET=xxx
REACT_APP_FB_MSG_SENDER_ID=xxx
REACT_APP_FB_APP_ID=xxx
